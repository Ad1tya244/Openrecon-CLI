# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
*.env
*.pem
*.key

# Output exports, scratch, & temporary artifacts
scratch/
*.log
results.txt
report.txt
scan_results.*
*.tmp

# User & Test Caches
.cache/
.openrecon_cache.json
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / Editor files
.DS_Store
.AppleDouble
.LSOverride
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.Trashes

# Whitelist Package Data & Assets
!openrecon/data/*.json
!assets/*
